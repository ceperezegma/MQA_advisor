# PPE login credentials — only needed when MQA_ENV=PPE (production metadata is public, so a
# PROD run needs no login). Never commit real values — .env is gitignored.
PPE_USERNAME=
PPE_PASSWORD=

# PPE base URL (optional — defaults to https://ppe.data.europa.eu/ if unset)
PPE_BASE_URL=https://ppe.data.europa.eu/

# Only needed to run the opt-in integration tests (`uv run pytest -m integration`):
# a dataset id known to exist on PPE, e.g. from /api/hub/repo/datasets/{id}.jsonld
PPE_TEST_DATASET_ID=

# Only needed for the standalone Data Service integration test: a dataservice
# id known to exist on PPE, e.g. from /api/hub/search/dataservices/{id}
PPE_TEST_DATASERVICE_ID=

# Which environment the pipeline targets (optional — defaults to "PROD" if unset): "PPE"
# (https://ppe.data.europa.eu/, needs PPE_USERNAME/PPE_PASSWORD) or "PROD"
# (https://data.europa.eu/, public, no login). One value drives metadata ingestion and every output folder, which are stored per
# environment (.../{PPE|PROD}/{catalogue}/). PPE_BASE_URL only overrides the PPE login/
# ingestion host and never affects PROD.
MQA_ENV=
