        {
            "@id": "http://data.europa.eu/88u/dataset/https-data-gov-lt-datasets-2283-",
            "dct:title": [
                {
                    "@language": "el-t-lt-t0-mtec",
                    "@value": "Μέσες μηνιαίες σταθερές (διορισμένες) αποδοχές των υπαλλήλων της δημοτικής διοίκησης που κατείχαν την ίδια θέση κατά το τρίτο τρίμηνο του 2022"
                },
                {
                    "@language": "bg-t-lt-t0-mtec",
                    "@value": "Средно месечно фиксирано (назначено) възнаграждение на служителите в общинската администрация, заемащи същата длъжност през третото тримесечие на 2022 г."
                },
                {
                    "@language": "hr-t-lt-t0-mtec",
                    "@value": "Prosječne mjesečne fiksne (imenovane) plaće zaposlenika općinske uprave na istom radnom mjestu u trećem tromjesečju 2022."
                },
                {
                    "@language": "pl-t-lt-t0-mtec",
                    "@value": "Średnie miesięczne stałe (wyznaczone) wynagrodzenie pracowników administracji gminnej zajmujących to samo stanowisko w III kwartale 2022 r."
                },
                {
                    "@language": "pt-t-lt-t0-mtec",
                    "@value": "Remuneração média mensal fixa (nomeada) dos trabalhadores da administração municipal que ocupam o mesmo cargo no terceiro trimestre de 2022"
                },
                {
                    "@language": "ga-t-lt-t0-mtec",
                    "@value": "Meánluach saothair seasta míosúil (ceaptha) fhostaithe an riaracháin bhardasaigh a bhfuil an post céanna acu in R3 2022"
                },
                {
                    "@language": "de-t-lt-t0-mtec",
                    "@value": "Durchschnittliche monatliche feste (ernannte) Vergütung der Mitarbeiter der Gemeindeverwaltung, die im dritten Quartal 2022 dieselbe Position innehatten"
                },
                {
                    "@language": "it-t-lt-t0-mtec",
                    "@value": "Retribuzione media mensile fissa (nominata) dei dipendenti dell'amministrazione comunale che ricoprivano la stessa posizione nel terzo trimestre del 2022"
                },
                {
                    "@language": "lt",
                    "@value": "Savivaldybės administracijos darbuotojų, einančių vienodas pareigas, 2022 m. III ketv. vidutinis mėnesinis nustatytasis (paskirtasis) darbo užmokestis"
                },
                {
                    "@language": "sk-t-lt-t0-mtec",
                    "@value": "Priemerná mesačná pevná (vymenovaná) odmena zamestnancov obecnej správy zastávajúcich rovnakú pozíciu v 3. štvrťroku 2022"
                },
                {
                    "@language": "mt-t-lt-t0-mtec",
                    "@value": "Ir-remunerazzjoni fissa medja fix-xahar (maħtura) tal-impjegati tal-amministrazzjoni muniċipali li għandhom l-istess pożizzjoni fit-tielet trimestru tal-2022"
                },
                {
                    "@language": "lv-t-lt-t0-mtec",
                    "@value": "Vidējais mēneša fiksētais (ieceltais) atalgojums pašvaldības pārvaldes darbiniekiem, kuri ieņem tādu pašu amatu 2022. gada 3. ceturksnī"
                },
                {
                    "@language": "fr-t-lt-t0-mtec",
                    "@value": "Rémunération mensuelle fixe (nommée) moyenne des employés de l’administration municipale occupant le même poste au troisième trimestre 2022"
                },
                {
                    "@language": "nl-t-lt-t0-mtec",
                    "@value": "Gemiddelde maandelijkse vaste (benoemde) beloning van werknemers van het gemeentebestuur met dezelfde functie in het derde kwartaal van 2022"
                },
                {
                    "@language": "fi-t-lt-t0-mtec",
                    "@value": "Samassa asemassa olevien kunnallishallinnon työntekijöiden keskimääräiset kiinteät (nimitetyt) kuukausipalkat vuoden 2022 kolmannella neljänneksellä"
                },
                {
                    "@language": "es-t-lt-t0-mtec",
                    "@value": "Remuneración media mensual fija (nombrada) de los empleados de la administración municipal que ocupaban el mismo puesto en el tercer trimestre de 2022"
                },
                {
                    "@language": "et-t-lt-t0-mtec",
                    "@value": "2022. aasta kolmandas kvartalis samal ametikohal töötavate munitsipaalvalitsuse töötajate keskmine igakuine kindlaksmääratud (ametisse nimetatud) töötasu"
                },
                {
                    "@language": "hu-t-lt-t0-mtec",
                    "@value": "Az azonos pozíciót betöltő önkormányzati alkalmazottak átlagos havi rögzített (kinevezett) javadalmazása 2022 harmadik negyedévében"
                },
                {
                    "@language": "da-t-lt-t0-mtec",
                    "@value": "Gennemsnitlig månedlig fast (udnævnt) aflønning af ansatte i den kommunale forvaltning i samme stilling i tredje kvartal 2022"
                },
                {
                    "@language": "uk-t-lt-t0-mtec",
                    "@value": "Середньомісячна фіксована (призначена) винагорода працівників муніципальної адміністрації на аналогічній посаді у ІІІ кварталі 2022 року"
                },
                {
                    "@language": "en",
                    "@value": "2022 of employees of the municipal administration holding equal positions. III quarter average monthly fixed (assigned) wage"
                },
                {
                    "@language": "sl-t-lt-t0-mtec",
                    "@value": "Povprečni mesečni fiksni (imenovani) prejemki zaposlenih v občinski upravi na enakem položaju v tretjem četrtletju leta 2022"
                },
                {
                    "@language": "sv-t-lt-t0-mtec",
                    "@value": "Genomsnittlig månatlig fast (utsedd) ersättning till anställda inom den kommunala förvaltningen med samma befattning under tredje kvartalet 2022"
                },
                {
                    "@language": "ro-t-lt-t0-mtec",
                    "@value": "Remunerația lunară medie fixă (numită) a angajaților administrației municipale care au deținut aceeași poziție în T3 2022"
                },
                {
                    "@language": "cs-t-lt-t0-mtec",
                    "@value": "Průměrná měsíční pevná (jmenovaná) odměna zaměstnanců obecní správy ve stejném postavení ve třetím čtvrtletí 2022"
                }
            ],
