            "dct:description": [
                {
                    "@language": "es-t-lt-t0-mtec",
                    "@value": "Lista de proveedores de educación con acceso a programas acreditados de educación no formal para niños"
                },
                {
                    "@language": "fi-t-lt-t0-mtec",
                    "@value": "Luettelo koulutuksen tarjoajista, joilla on pääsy akkreditoituihin epävirallisiin lasten koulutusohjelmiin"
                },
                {
                    "@language": "sl-t-lt-t0-mtec",
                    "@value": "Seznam ponudnikov izobraževanja z dostopom do akreditiranih programov neformalnega izobraževanja za otroke"
                },
                {
                    "@language": "en",
                    "@value": "List of education providers with access to accredited non-formal education programs for children"
                },
                {
                    "@language": "mt-t-lt-t0-mtec",
                    "@value": "Lista ta’ fornituri tal-edukazzjoni b’aċċess għal programmi ta’ edukazzjoni mhux formali akkreditati għat-tfal"
                },
                {
                    "@language": "ro-t-lt-t0-mtec",
                    "@value": "Lista furnizorilor de educație care au acces la programe acreditate de educație non-formală pentru copii"
                },
                {
                    "@language": "et-t-lt-t0-mtec",
                    "@value": "Loetelu haridusasutustest, kellel on juurdepääs lastele mõeldud akrediteeritud mitteformaalse hariduse programmidele"
                },
                {
                    "@language": "ga-t-lt-t0-mtec",
                    "@value": "Liosta de sholáthraithe oideachais a bhfuil rochtain acu ar chláir oideachais sheachfhoirmiúla chreidiúnaithe do leanaí"
                },
                {
                    "@language": "pl-t-lt-t0-mtec",
                    "@value": "Wykaz organizatorów kształcenia mających dostęp do akredytowanych programów kształcenia pozaformalnego dla dzieci"
                },
                {
                    "@language": "uk-t-lt-t0-mtec",
                    "@value": "Перелік закладів освіти, які мають доступ до акредитованих програм неформальної освіти для дітей"
                },
                {
                    "@language": "el-t-lt-t0-mtec",
                    "@value": "Κατάλογος παρόχων εκπαίδευσης με πρόσβαση σε διαπιστευμένα προγράμματα μη τυπικής εκπαίδευσης για παιδιά"
                },
                {
                    "@language": "cs-t-lt-t0-mtec",
                    "@value": "Seznam poskytovatelů vzdělávání s přístupem k akreditovaným programům neformálního vzdělávání pro děti"
                },
                {
                    "@language": "de-t-lt-t0-mtec",
                    "@value": "Liste der Bildungsanbieter mit Zugang zu akkreditierten nichtformalen Bildungsprogrammen für Kinder"
                },
                {
                    "@language": "hu-t-lt-t0-mtec",
                    "@value": "A gyermekeknek szóló akkreditált nem formális oktatási programokhoz hozzáféréssel rendelkező oktatási szolgáltatók jegyzéke"
                },
                {
                    "@language": "pt-t-lt-t0-mtec",
                    "@value": "Lista de prestadores de ensino com acesso a programas de ensino não formal acreditados para crianças"
                },
                {
                    "@language": "fr-t-lt-t0-mtec",
                    "@value": "Liste des prestataires d’enseignement ayant accès à des programmes d’éducation non formelle accrédités pour les enfants"
                },
                {
                    "@language": "lv-t-lt-t0-mtec",
                    "@value": "Izglītības pakalpojumu sniedzēju saraksts, kuriem ir piekļuve akreditētām bērnu neformālās izglītības programmām"
                },
                {
                    "@language": "sv-t-lt-t0-mtec",
                    "@value": "Förteckning över utbildningsanordnare med tillgång till ackrediterade icke-formella utbildningsprogram för barn"
                },
                {
                    "@language": "sk-t-lt-t0-mtec",
                    "@value": "Zoznam poskytovateľov vzdelávania s prístupom k akreditovaným programom neformálneho vzdelávania pre deti"
                },
                {
                    "@language": "da-t-lt-t0-mtec",
                    "@value": "Liste over uddannelsesudbydere med adgang til akkrediterede ikkeformelle uddannelsesprogrammer for børn"
                },
                {
                    "@language": "it-t-lt-t0-mtec",
                    "@value": "Elenco degli erogatori di istruzione che hanno accesso a programmi di istruzione non formale accreditati per i bambini"
                },
                {
                    "@language": "bg-t-lt-t0-mtec",
                    "@value": "Списък на доставчиците на образование с достъп до акредитирани програми за неформално образование за деца"
                },
                {
                    "@language": "nl-t-lt-t0-mtec",
                    "@value": "Lijst van onderwijsaanbieders met toegang tot geaccrediteerde niet-formele onderwijsprogramma's voor kinderen"
                },
                {
                    "@language": "hr-t-lt-t0-mtec",
                    "@value": "Popis pružatelja obrazovanja s pristupom akreditiranim programima neformalnog obrazovanja za djecu"
                },
                {
                    "@language": "lt",
                    "@value": "Švietimo teikėjų, turinčių galimybę vykdyti akredituotas neformaliojo vaikų švietimo programas, sąrašas"
                }
