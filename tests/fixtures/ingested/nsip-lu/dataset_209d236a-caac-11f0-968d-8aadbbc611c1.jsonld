            "dct:title": {
                "@language": "eng",
                "@value": "Secondary identified diagnosis related to stays or treatments in hospital"
            },
            "dct:identifier": "209d236a-caac-11f0-968d-8aadbbc611c1",
            "dcat:contactPoint": {
                "@id": "_:8ee50fd1c0e91b474308287fd3982c11"
            },
            "dct:description": {
                "@language": "eng",
                "@value": "This dataset contains secondary diagnoses that may be declared during hospital stays.  \nThis dataset is part of those provided by the IGSS within the framework of the Luxembourg Microdata Platform on Labour and Social Protection. All datasets offered by the IGSS are designed to be interoperable through the use of common pseudonymized identifiers, enabling the linkage of information across different datasets. More particularly, this dataset  must be interconnected with the “Stays and treatments in hospital” dataset using the variable hosp_stay_treat_IDnumber. \nAll the variables in this dataset are personal data and are subject to GDPR compliant protection measures. \nScope: hospital stays and treatments, including day cases, outpatient cases and inpatient cases, registered in a Luxembourg hospital. \nDelay for providing the most recent data: current month -24. \nData sources : CNS."
            },
            "dct:language": {
                "@id": "http://publications.europa.eu/resource/authority/language/ENG"
