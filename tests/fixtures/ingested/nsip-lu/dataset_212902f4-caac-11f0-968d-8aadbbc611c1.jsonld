            "dct:title": {
                "@language": "eng",
                "@value": "Medications"
            },
            "dct:identifier": "212902f4-caac-11f0-968d-8aadbbc611c1",
            "dct:description": {
                "@language": "eng",
                "@value": "This dataset contains all prescribed medications covered by social security, except those prescribed in the context of an inpatient stay or treatment in hospital. \nThis dataset is part of those provided by the IGSS within the framework of the Luxembourg Microdata Platform on Labour and Social Protection. All datasets offered by the IGSS are designed to be interoperable through the use of common pseudonymized identifiers, enabling the linkage of information across different datasets. \nAll the variables in this dataset are personal data and are subject to GDPR compliant protection measures. \nScope: medications covered by social security, except those prescribed in the context of an inpatient stay or treatment in hospital. \nDelay for providing the most recent data: current month -12. \nData sources : CNS."
            },
