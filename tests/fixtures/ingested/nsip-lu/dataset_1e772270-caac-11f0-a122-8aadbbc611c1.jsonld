            "dct:title": {
                "@language": "eng",
                "@value": "Work absences"
            },
            "dct:description": {
                "@language": "eng",
                "@value": "This dataset contains all recorded periods of absence for private status employees.\nThis dataset is part of those provided by the IGSS within the framework of the Luxembourg Microdata Platform on Labour and Social Protection. All datasets offered by the IGSS are designed to be interoperable through the use of common pseudonymized identifiers, enabling the linkage of information across different datasets.\nAll the variables in this dataset are personal data and are subject to GDPR compliant protection measures. \nScope: absence periods carried out by private status employees. \nDelay for providing the most recent data: current month -3. \nData sources : CCSS."
            },
            "http://www.w3.org/ns/dpv#dataProtectionType": {
