        {
            "@id": "http://data.europa.eu/88u/dataset/1f84b3b2-caac-11f0-a122-8aadbbc611c1",
            "dct:publisher": {
                "@id": "_:c0d8c27ebb63007f0cc5537089303240"
            },
            "dct:description": {
                "@language": "eng",
                "@value": "This dataset contains all the medical acts performed by doctors and dentists for a reference period (year and month), covered by Luxembourg social security and performed in the country. This includes residents and non-residents, provided they are affiliated to the Luxembourg social protection system. \nThis dataset is part of those provided by the IGSS within the framework of the Luxembourg Microdata Platform on Labour and Social Protection. All datasets offered by the IGSS are designed to be interoperable through the use of common pseudonymized identifiers, enabling the linkage of information across different datasets. \nAll the variables in this dataset are personal data and are subject to GDPR compliant protection measures. \nScope: medical acts performed by doctors and dentists, covered by Luxembourg social security and performed in the country. \nDelay for providing the most recent data: current month -24. \nData sources : CNS."
            },
            "dct:spatial": {
                "@id": "http://publications.europa.eu/resource/authority/country/LUX"
