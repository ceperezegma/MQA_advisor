            "dct:temporal": {
                "@id": "_:8a15185ca9000cea32ea2a780797a107"
            },
            "dct:description": {
                "@language": "eng",
                "@value": "This dataset contains children pseudonymized individual identification number of residents in Luxembourg and crossborder workers if their children are eligible for Luxembourg family benefits.\nTo be useful, this dataset must be interconnected with some datasets provided by the IGSS within the framework of the Luxembourg Microdata Platform on Labour and Social Protection. For example, this dataset can be linked to “Individual sociodemographic characteristics” dataset to obtain the age of children. \nDelay for providing the most recent data: current month -3.\nData source : CCSS."
            },
