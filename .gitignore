# IDE
.idea/

# Excel lock files
~$*.xlsx

# Secrets
.env
.env.*
!.env.example

# Claude Code local settings
.claude/settings.local.json

# Python bytecode
__pycache__/
*.pyc

# Virtual environment
.venv/

# Generated output, never source: the manifests and the fetched catalogue data (+ the SQLite
# database). Keep both folders themselves tracked (via .gitkeep) so they exist after a fresh
# clone; their contents are never tracked.
/catalogues_to_fetch/*
!/catalogues_to_fetch/.gitkeep
/fetched_catalogues_data/*
!/fetched_catalogues_data/.gitkeep

# Copies of the data folders created when the app runs with src/ as working directory
/src/**/catalogues_to_fetch/
/src/**/fetched_catalogues_data/

# Scratch output of the tests/manual_*.py scripts
manual_tests/

# Databases are never tracked (anywhere in the repo)
*.sqlite
*.sqlite3
*.db

# Per-run LLM interaction logs of the propose step (logs/propose/)
logs/
